{
  "name": "@danielsimonjr/sciengjs",
  "version": "1.0.5",
  "private": false,
  "description": "A local rendering engine for science and engineering diagrams, documents and models",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./raster": {
      "types": "./dist/raster/index.d.ts",
      "default": "./dist/raster/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.ts",
      "default": "./dist/mermaid/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "default": "./dist/math/index.js"
    },
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "default": "./dist/plot/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "default": "./dist/html/index.js"
    },
    "./mesh": {
      "types": "./dist/mesh/index.d.ts",
      "default": "./dist/mesh/index.js"
    },
    "./sysml": {
      "types": "./dist/sysml/index.d.ts",
      "default": "./dist/sysml/index.js"
    },
    "./tex": {
      "types": "./dist/tex/index.d.ts",
      "default": "./dist/tex/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "node test/smoke/smoke.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:node": "node --test test/node/worker.node.mjs test/node/eval-render.node.mjs test/node/worker-execargv.node.mjs test/node/math.node.mjs test/node/mesh.node.mjs test/node/tex-timeout.node.mjs"
  },
  "keywords": [
    "graphviz",
    "mermaid",
    "latex",
    "tikz",
    "svg",
    "diagram",
    "rendering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/sciengjs.git"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/sciengjs/issues"
  },
  "homepage": "https://github.com/danielsimonjr/sciengjs#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "mermaid": "11.17.2",
    "plotly.js-dist-min": "4.2.0",
    "three": "0.187.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@viz-js/viz": "3.31.0",
    "manifold-3d": "3.2.1",
    "occt-import-js": "0.0.23",
    "parse5": "8.1.0"
  }
}
